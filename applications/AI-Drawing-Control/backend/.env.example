# Copy to .env (scripts\SETUP.bat writes it for you). Never commit .env.
DATABASE_URL=
DB_SSL_MODE=disable
PORTAL_JWT_SECRET=
JWT_ALGORITHM=HS256
PORTAL_SERVICE_KEY=
PORTAL_URL=http://nibl
STORAGE_BACKEND=local
STORAGE_DIR=D:/npd-files
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=someone@nibl.in
SMTP_PASSWORD=
EMAIL_ENABLED=true
SMTP_FROM_NAME=Drawing Control
APP_BASE_URL=http://nibl/drawing-control
CORS_ORIGINS=http://nibl,http://localhost:5173,http://127.0.0.1:5173
DRAWING_REMINDER_HOURS=24

# development on a PC, production on the server (hides the /docs API pages)
ENVIRONMENT=development
