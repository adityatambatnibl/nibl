# Copy to .env (scripts\SETUP.bat writes it for you). Never commit .env.
JWT_SECRET=
JWT_ALGORITHM=HS256
OIPM_JWT_SECRET=
OIPM_JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=someone@nibl.in
SMTP_PASSWORD=
SMTP_FROM_NAME=APQP Tracking System
EMAIL_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kolkata
OVERDUE_CHECK_HOUR=9
SUPABASE_TABLE=
SUPABASE_BUCKET=
SQL_ECHO=false
SUPABASE_DB_URL=
SUPABASE_DB_SSL_MODE=disable
STORAGE_BACKEND=local
STORAGE_DIR=D:/npd-files
APP_BASE_URL=http://nibl/npd
CORS_ORIGINS=http://nibl,http://nibl:5174
SCHEDULER_ENABLED=true
PORTAL_SERVICE_KEY=
USER_SYNC_ENABLED=false

# development on a PC, production on the server (hides the /docs API pages)
ENVIRONMENT=development
