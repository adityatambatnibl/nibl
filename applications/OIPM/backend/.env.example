# Copy to .env (scripts\SETUP.bat writes it for you). Never commit .env.
APP_NAME=NIBL OIPM
ENVIRONMENT=development
FRONTEND_URL=http://nibl
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=nibl_oipm
DB_USER=postgres
DB_PASSWORD=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=someone@nibl.in
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=someone@nibl.in
PORTAL_SERVICE_KEY=
PORTAL_INTERNAL_URL=http://127.0.0.1:8010/portal-api

# auto (default): secure sign-in cookie only when ENVIRONMENT=production and FRONTEND_URL is https://
COOKIE_SECURE=auto
