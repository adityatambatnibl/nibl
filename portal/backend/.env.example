# Copy to .env (scripts\SETUP.bat writes it for you). Never commit .env.
APP_NAME=NIBL Application Portal
ENVIRONMENT=development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=nibl_portal
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
PORTAL_SERVICE_KEY=
FRONTEND_URL=http://nibl
CORS_ORIGINS=http://nibl,http://localhost:5173,http://127.0.0.1:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=someone@nibl.in
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=someone@nibl.in

# auto (default): secure sign-in cookie only when ENVIRONMENT=production and FRONTEND_URL is https://
COOKIE_SECURE=auto
