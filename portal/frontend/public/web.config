<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS site root  =  portal/frontend/dist
     Applications are separate IIS applications under this site:
       /oipm                -> applications/OIPM/frontend/dist
       /npd                 -> applications/NPD/frontend/dist
       /drawing-control     -> applications/AI-Drawing-Control/frontend/dist
       /ai-drawing-control  -> old address, redirects to /drawing-control (shared/deployment/iis-old-drawing-url)
     Needs IIS URL Rewrite + Application Request Routing (proxy enabled). -->
<configuration>
  <system.webServer>
    <!-- Uploads up to 200 MB pass through IIS (drawings, attachments). Inherited by every app. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="209715200" />
      </requestFiltering>
    </security>
    <!-- Basic browser protection. Inherited by every app. -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>
    <rewrite>
      <rules>
        <!-- HTTPS-REDIRECT: turned on by scripts\PREPARE-PRODUCTION.bat when the
             public address is https://... (needs an https binding on the site).
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions><add input="{HTTPS}" pattern="off" /></conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        HTTPS-REDIRECT-END -->
        <rule name="Portal API" stopProcessing="true">
          <match url="^portal-api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8010/portal-api/{R:1}" />
        </rule>
        <!-- OIPM's API stays at /api/v1 (its screens call it from /oipm). -->
        <rule name="OIPM API" stopProcessing="true">
          <match url="^api/v1/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/api/v1/{R:1}" />
        </rule>
        <rule name="Portal SPA" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(oipm|npd|drawing-control|ai-drawing-control)(/|$)" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(api|portal-api)/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
  <!-- index.html is never cached, so users get the new screens right after an
       update (the hashed files in /assets can be cached for a long time). -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
