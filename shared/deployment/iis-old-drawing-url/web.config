<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS application /ai-drawing-control (OLD address) -> point it at THIS folder.
     Sends every old link (bookmarks, earlier e-mail buttons) to the same page
     under /drawing-control, e.g. /ai-drawing-control/view/<id> -> /drawing-control/view/<id>. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <clear />
        <rule name="Old Drawing URL" stopProcessing="true">
          <match url="(.*)" />
          <action type="Redirect" url="/drawing-control/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
